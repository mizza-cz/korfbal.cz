<section class="heroBoard">
  <div class="container">
    <div class="heroBoard-grid">
      <a href="#" class="heroBoard-main">
        <div class="tag-accent">extraliga</div>
        <img
          srcset="
            https://picsum.photos/708/598   1x,
            https://picsum.photos/1416/1196 2x
          "
          alt="post"
          loading="lazy"
        />
        <div class="heroBoard-main__content">
          <h1 class="h3 text-white mb-3">
            Nominace na ME 2026: Kratochvíl povolal čtyři nováčky
          </h1>
          <p class="text-base-16 text-paper-2">
            Lídr Extraligy si po dvou těsných výhrách dovolil nečekanou
            demonstraci síly. Brno přehrálo v hale Vodova obhájce titulu o devět
            košů a v posledním kole základní části se posunulo na první místo
            tabulky.
          </p>
        </div>
      </a>
      <div class="heroBoard-side">
        <div class="heroBoard-posts">
          {% for i in 1..4 %}
          <a href="#" class="heroBoard__post">
            <div class="heroBoard__post-content">
              <div class="tag-accent mb-2">extraliga</div>
              <div class="h6">
                Brno smetlo Prahu o devět košů a posunulo se do čela tabulky
              </div>
            </div>
            <div class="heroBoard__post-img">
              <img
                srcset="
                  https://picsum.photos/165/120 1x,
                  https://picsum.photos/330/240 2x
                "
                alt="post"
                loading="lazy"
              />
            </div>
          </a>
          {% endfor %}
          <a href="#" class="button-primary mx-auto mt-auto">
            Další články
            <svg
              width="11"
              height="11"
              viewBox="0 0 11 11"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M5.03622 10.3907L3.75355 9.11794L6.74148 6.13002H0V4.2607H6.74148L3.75355 1.27774L5.03622 4.44651e-05L10.2315 5.19536L5.03622 10.3907Z"
                fill="#fff"
              />
            </svg>
          </a>
        </div>
        <div class="heroBoard-matches">
          <div class="matchCard">
            <div
              class="d-flex align-items-center justify-content-between gap-4 text-bold-10 text-uppercase mb-4"
            >
              <div class="text-black-60">24. KOLO</div>
              <div class="text-bold-10 text-black-50 text-uppercase">
                ODEHRÁNO
              </div>
            </div>
            <div
              class="d-flex align-items-center justify-content-between gap-4 mb-2"
            >
              <div class="d-flex align-items-center gap-4">
                <img
                  class="object-fit-contain"
                  width="34"
                  height="34"
                  src="images/content/guardians.png"
                  alt="club"
                />
                <div class="text-bold-15">KK Brno</div>
              </div>
              <div class="h4">24</div>
            </div>
            <div
              class="d-flex align-items-center justify-content-between gap-4"
            >
              <div class="d-flex align-items-center gap-4">
                <img
                  class="object-fit-contain"
                  width="34"
                  height="34"
                  src="images/content/guardians.png"
                  alt="club"
                />
                <div class="text-bold-15">SK Praha</div>
              </div>
              <div class="h4">15</div>
            </div>
            <div class="matchCard__bottom">
              <div class="text-bold-10 text-black-60 text-uppercase">
                12.4. · 17:00
              </div>
              <a class="link text-accent" href="#">
                DETAIL
                <svg
                  width="11"
                  height="11"
                  viewBox="0 0 11 11"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5.03622 10.3907L3.75355 9.11794L6.74148 6.13002H0V4.2607H6.74148L3.75355 1.27774L5.03622 4.44651e-05L10.2315 5.19536L5.03622 10.3907Z"
                    fill="#d7141a"
                  /></svg
              ></a>
            </div>
          </div>
          <div class="matchCard matchCard--live">
            <div
              class="d-flex align-items-center justify-content-between gap-4 text-bold-10 text-uppercase mb-4"
